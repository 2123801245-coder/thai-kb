.DS_Store
~$*
.freebuff/
.kb/
.vok/
.docxwork/
media/*
!media/base-reading/
data-personal/

# 排查用临时产物（抽帧、OCR、临时查看页）——不入库，用完直接删
.ocrwork/
.tmpframes/
tmpframes/
viewframes.html

# Android 套壳（tools/make-apk.js）的本地工程与产物，不入库
apk/node_modules/
apk/android/
apk/www/
apk/thai-kb.keystore
apk/.stray-resources/   # make-apk 清理出来的非法资源副本

# 仓库根目录里临时跑脚本留下的依赖与工作目录（如解压 .rar 用的 unrar-js）
node_modules/
package-lock.json
tmp/
# 根目录的临时素材与构建残留
课外阅读小组-压缩.mp4
*.log
x264scan.log
apk/
